{
  "name": "integron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev:demo": "node --experimental-strip-types --experimental-sqlite apps/api/src/server.ts",
    "dev:local": "RUNTIME_PROFILE=local OUTBOUND_ENABLED=false node --experimental-strip-types --experimental-sqlite apps/api/src/server.ts",
    "dev:api:demo": "RUNTIME_PROFILE=demo OUTBOUND_ENABLED=false node --experimental-strip-types --experimental-sqlite apps/api/src/fastify-server.ts",
    "dev:api:local": "RUNTIME_PROFILE=local OUTBOUND_ENABLED=false node --experimental-strip-types --experimental-sqlite apps/api/src/fastify-server.ts",
    "dev:postgres": "RUNTIME_PROFILE=postgres OUTBOUND_ENABLED=false node --experimental-strip-types --experimental-sqlite apps/api/src/fastify-server.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test": "node --experimental-strip-types --experimental-sqlite --test tests/demo.test.ts tests/persistence.test.ts tests/http.test.ts tests/fastify.test.ts tests/tdlib-unit.test.ts tests/planner-evidence.test.ts tests/whatsapp-user.test.ts tests/owner-api-auth.test.ts tests/livekit-sip.test.ts tests/dev-observer.test.ts tests/dev-planner.test.ts",
    "test:tdlib:unit": "node --experimental-strip-types --test tests/tdlib-unit.test.ts",
    "preflight:local": "node scripts/local-preflight.mjs local",
    "preflight:tdlib": "node scripts/local-preflight.mjs tdlib",
    "test:postgres": "node --experimental-strip-types --experimental-sqlite --test-concurrency=1 --test tests/postgres.test.ts tests/telegram.test.ts tests/orchestrator.test.ts tests/text-transport.test.ts tests/tdlib-user.test.ts tests/llm-workflow.test.ts tests/pause-resume.test.ts tests/whatsapp-postgres.test.ts tests/budget.test.ts tests/owner-questions.test.ts tests/approvals.test.ts tests/budget-reservations.test.ts tests/sip-calls.test.ts tests/sip-termination.test.ts tests/dev-observer-postgres.test.ts tests/dev-planner-postgres.test.ts",
    "dev:telegram": "RUNTIME_PROFILE=postgres OUTBOUND_ENABLED=false node --experimental-strip-types --experimental-sqlite apps/worker/src/telegram.ts",
    "dev:orchestrator": "RUNTIME_PROFILE=postgres OUTBOUND_ENABLED=false node --experimental-strip-types apps/worker/src/orchestrator.ts",
    "dev:agent-telegram": "RUNTIME_PROFILE=postgres OUTBOUND_ENABLED=false node --experimental-strip-types apps/worker/src/agent-telegram.ts",
    "dev:agent-tdlib": "RUNTIME_PROFILE=postgres OUTBOUND_ENABLED=false node --experimental-strip-types apps/worker/src/agent-tdlib.ts",
    "test:whatsapp:unit": "node --experimental-strip-types --test tests/whatsapp-user.test.ts",
    "dev:agent-whatsapp": "RUNTIME_PROFILE=postgres OUTBOUND_ENABLED=false node --experimental-strip-types apps/worker/src/agent-whatsapp.ts --connect-real-whatsapp",
    "preflight:whatsapp": "node scripts/local-preflight.mjs whatsapp",
    "dev:sip-guardian": "node --experimental-strip-types apps/worker/src/sip-guardian.ts",
    "dev:github:once": "RUNTIME_PROFILE=postgres node --experimental-strip-types apps/worker/src/dev-github-observer.ts --once",
    "dev:github:serve": "RUNTIME_PROFILE=postgres node --experimental-strip-types apps/worker/src/dev-github-observer.ts --serve",
    "dev:roadmap": "RUNTIME_PROFILE=postgres node --experimental-strip-types apps/worker/src/dev-roadmap.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "fastify": "5.6.2"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  },
  "optionalDependencies": {
    "tdl": "8.1.0",
    "prebuilt-tdlib": "0.1008065.0",
    "@whiskeysockets/baileys": "6.7.22",
    "qrcode-terminal": "0.12.0",
    "livekit-server-sdk": "2.19.1"
  }
}
