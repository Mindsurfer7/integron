generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// P0 scripted tasks; P1 adds durable owner decisions/notifications.
// Real contacts/conversations/voice sessions are not yet implemented.
model DemoTask {
  id             String               @id @db.Uuid
  payload        Json                 @db.JsonB
  revision       Int                  @default(0)
  createdAt      DateTime
  clarifications OwnerClarification[]
  @@index([createdAt])
}

model OwnerClarification {
  id           String             @id @db.Uuid
  taskId       String             @db.Uuid
  task         DemoTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  state        String             @default("pending")
  expiresAt    DateTime
  createdAt    DateTime           @default(now())
  answeredAt   DateTime?
  choice       String?
  notification OwnerNotification?
  @@index([state, expiresAt])
  @@index([taskId])
}

model OwnerNotification {
  id              String             @id @default(uuid()) @db.Uuid
  clarificationId String             @unique @db.Uuid
  clarification   OwnerClarification @relation(fields: [clarificationId], references: [id], onDelete: Cascade)
  state           String             @default("queued")
  attempts        Int                @default(0)
  leasedUntil     DateTime?
  messageId       String?
  lastError       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  @@index([state, createdAt])
}

model TelegramPollingCursor {
  id           Int    @id
  lastUpdateId BigInt @default(0)
}


// P1.2 durable orchestration; currently only deterministic mock executors.
// Leases fence concurrent workers, and preallocated IDs make collecting idempotent.
model WorkflowRun {
  id              String          @id @db.Uuid
  goal            String
  clarificationId String          @db.Uuid
  transport       String          @default("mock")
  targetChatId    String?
  delivery        TextDelivery?
  messages        TextMessage[]
  facts           WorkflowFact[]
  costs           WorkflowCostEntry[]
  costReservations WorkflowCostReservation[]
  sipCalls         WorkflowSipCall[]
  targets         WorkflowTarget[]
  conversations   WorkflowConversation[]
  ownerQuestions   WorkflowOwnerQuestion[]
  approvals        WorkflowApproval[]
  maxCostCents    Int             @default(500)
  spentCents      Int             @default(0)
  reservedCents   Int             @default(0)
  demoTaskId      String?         @db.Uuid
  state           String          @default("queued")
  pausedFrom      String?
  step            String          @default("plan")
  plan            Json?           @db.JsonB
  availableAt     DateTime        @default(now())
  leaseToken      String?
  leasedUntil     DateTime?
  failures        Int             @default(0)
  lastError       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  finishedAt      DateTime?
  events          WorkflowEvent[]
  @@index([state, availableAt])
  @@index([leasedUntil])
}

model WorkflowEvent {
  id         String      @id @default(uuid()) @db.Uuid
  workflowId String      @db.Uuid
  workflow   WorkflowRun @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  kind       String
  metadata   Json?       @db.JsonB
  createdAt  DateTime    @default(now())
  @@index([workflowId, createdAt])
}


// Explicitly consented Telegram Bot test conversations. Never used for discovery.
// No stored credentials; private chat IDs and message bodies remain only in the local DB.
model TextDelivery {
  id             String      @id @default(uuid()) @db.Uuid
  workflowId     String      @unique @db.Uuid
  workflow       WorkflowRun @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  channel        String      @default("telegram_bot_test")
  chatId         String
  body           String
  state          String      @default("queued")
  attempts       Int         @default(0)
  leasedUntil    DateTime?
  providerId     String?
  expiresAt      DateTime
  lastError      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  @@index([state, createdAt])
  @@index([chatId, providerId])
}

model TextMessage {
  id                String      @id @default(uuid()) @db.Uuid
  workflowId        String      @db.Uuid
  workflow          WorkflowRun @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  channel           String
  chatId            String
  direction         String
  providerMessageId String
  replyToProviderId String?
  body              String
  createdAt         DateTime    @default(now())
  facts             WorkflowFact[]
  @@unique([channel, chatId, providerMessageId, direction])
  @@index([workflowId, createdAt])
}

model AgentTelegramCursor {
  id           Int    @id
  lastUpdateId BigInt @default(0)
}


// Conservative source-linked facts. "tentative" means an unverified
// third-party statement; never imply verified stock or prices.
model WorkflowFact {
  id           String      @id @default(uuid()) @db.Uuid
  workflowId   String      @db.Uuid
  workflow     WorkflowRun @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  messageId    String      @db.Uuid
  message      TextMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  field        String
  value        String
  quote        String
  startOffset  Int
  endOffset    Int
  status       String      @default("tentative")
  createdAt    DateTime    @default(now())
  @@unique([messageId, field, startOffset, endOffset])
  @@index([workflowId, field])
}

// P1 durable, idempotent accounting of already incurred metered costs.
// The ledger does not itself authorize paid API requests or phone calls.
model WorkflowCostEntry {
  id          String      @id @default(uuid()) @db.Uuid
  workflowId  String      @db.Uuid
  workflow    WorkflowRun @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  eventKey    String
  category    String
  amountCents Int
  createdAt   DateTime    @default(now())
  @@unique([workflowId, eventKey])
  @@index([workflowId, createdAt])
}

// Normalized P1 workflow addresses. Targets are mock organizations or expressly
// allowlisted private test recipients; no automated contact discovery.
model WorkflowTarget {
  id           String                 @id @default(uuid()) @db.Uuid
  workflowId   String                 @db.Uuid
  workflow     WorkflowRun            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceKey    String
  label        String
  channel      String
  recipientId  String?
  origin       String
  createdAt    DateTime               @default(now())
  conversations WorkflowConversation[]
  @@unique([workflowId, sourceKey])
  @@index([workflowId, createdAt])
}

model WorkflowConversation {
  id          String         @id @default(uuid()) @db.Uuid
  workflowId  String         @db.Uuid
  workflow    WorkflowRun    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  targetId    String         @db.Uuid
  target      WorkflowTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  channel     String
  state       String         @default("planned")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@unique([workflowId, targetId])
  @@index([workflowId, state])
}

// P1 conflict clarification for an individual durable workflow.
// Separate from legacy scripted DemoTask owner choices and from approvals.
// Answer text is data, never permission to spend money or send messages.
model WorkflowOwnerQuestion {
  id              String                       @id @default(uuid()) @db.Uuid
  workflowId      String                       @db.Uuid
  workflow        WorkflowRun                  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  requestKey      String
  sourceMessageId String?                      @db.Uuid
  prompt          String
  kind            String                       @default("free_text")
  ownerUserId     String?
  ownerChatId     String?
  state           String                       @default("pending")
  answer          String?
  answeredVia     String?
  answeredAt      DateTime?
  expiresAt       DateTime
  createdAt       DateTime                     @default(now())
  notification    WorkflowOwnerNotification?
  @@unique([workflowId, requestKey])
  @@index([workflowId, state])
  @@index([state, expiresAt])
}

model WorkflowOwnerNotification {
  id             String                @id @default(uuid()) @db.Uuid
  questionId     String                @unique @db.Uuid
  question       WorkflowOwnerQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  state          String                @default("queued")
  attempts       Int                   @default(0)
  leasedUntil    DateTime?
  messageId      String?
  lastError      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  @@index([state, createdAt])
  @@index([messageId])
}

// P1 simulation-only owner approvals. An approval is NOT a provider action.
// Exact action intent digest, recipient, amount and currency are immutable.
// No real payments, bookings or sensitive-data disclosures are permitted.
model WorkflowApproval {
  id              String                  @id @default(uuid()) @db.Uuid
  workflowId      String                  @db.Uuid
  workflow        WorkflowRun             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  requestKey      String
  mode            String                  @default("simulation_only")
  actionType      String
  recipientRef    String
  summary         String
  amountMinor     Int?
  currency        String?
  intentDigest    String
  ownerUserId     String
  ownerChatId     String
  state           String                  @default("pending")
  decisionVia     String?
  decidedAt       DateTime?
  consumedAt      DateTime?
  expiresAt       DateTime
  createdAt       DateTime                @default(now())
  notification    WorkflowApprovalNotification?
  @@unique([workflowId, requestKey])
  @@index([workflowId, state])
  @@index([state, expiresAt])
}

model WorkflowApprovalNotification {
  id             String           @id @default(uuid()) @db.Uuid
  approvalId     String           @unique @db.Uuid
  approval       WorkflowApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  state          String           @default("queued")
  attempts       Int              @default(0)
  leasedUntil    DateTime?
  messageId      String?
  lastError      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  @@index([state, createdAt])
  @@index([messageId])
}

// Preflight authorization of bounded future provider usage. Reservations
// aren't invoices. UNKNOWN external side effects remain reserved until verified.
model WorkflowCostReservation {
  id                String      @id @default(uuid()) @db.Uuid
  workflowId        String      @db.Uuid
  workflow          WorkflowRun @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  eventKey          String
  category          String
  maxAmountCents    Int
  actualAmountCents Int?
  state             String      @default("reserved")
  createdAt         DateTime    @default(now())
  settledAt         DateTime?
  @@unique([workflowId, eventKey])
  @@index([workflowId, state])
}

// P3.1 manual/test-only call dispatch record. No auto retries after attempting.
// Storing recipient here is confined to local PostgreSQL, never source control.
model WorkflowSipCall {
  id                  String      @id @default(uuid()) @db.Uuid
  workflowId          String      @db.Uuid
  workflow            WorkflowRun @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actionKey           String
  number              String
  budgetReservationKey String
  state               String      @default("prepared")
  deadlineAt          DateTime?
  stopRequestedAt     DateTime?
  stopReason          String?
  terminationState    String      @default("none")
  terminationAt       DateTime?
  roomName            String?
  participantIdentity String?
  providerCallId      String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  @@unique([workflowId, actionKey])
  @@index([state, createdAt])
  @@index([deadlineAt, stopRequestedAt])
}


// Development orchestration D1: strictly separate from outreach WorkflowRun.
// GitHub observation cannot authorize code edits, merges, deployments or outreach.
model DevProject {
  slug         String          @id
  name         String
  repositories DevRepository[]
  phases       DevPhase[]
}

model DevRepository {
  id                String             @id @default(uuid()) @db.Uuid
  projectSlug       String
  project           DevProject         @relation(fields: [projectSlug], references: [slug])
  fullName          String             @unique
  integrationBranch String
  enabled           Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  snapshot          DevGithubSnapshot?
  deliveries        DevGithubDelivery[]
  agentSessions     DevAgentSession[]
  @@index([projectSlug])
}

model DevGithubSnapshot {
  repositoryId String        @id @db.Uuid
  repository   DevRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  payload      Json          @db.JsonB
  observedAt   DateTime
  stale        Boolean       @default(false)
  errorCode    String?
  updatedAt    DateTime      @updatedAt
  @@index([stale, observedAt])
}

model DevGithubDelivery {
  id            String        @id @default(uuid()) @db.Uuid
  repositoryId  String        @db.Uuid
  repository    DevRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  deliveryId    String        @unique
  eventType     String
  payloadSha256 String
  receivedAt    DateTime      @default(now())
  @@index([repositoryId, receivedAt])
}


// D2: roadmap execution planning. Status is NOT inferred from a merged PR.
// Phase acceptance is intentionally not writable through the D2 import path.
model DevPhase {
  id                  String          @id @default(uuid()) @db.Uuid
  projectSlug         String
  project             DevProject      @relation(fields: [projectSlug], references: [slug], onDelete: Restrict)
  code                String
  workstream          String
  title               String
  description         String          @default("")
  state               String          @default("planned")
  acceptanceCriteria  Json            @db.JsonB
  acceptedAt          DateTime?
  acceptanceEvidence  Json?           @db.JsonB
  prerequisites       DevDependency[] @relation("DependentPhase")
  requiredBy          DevDependency[] @relation("PrerequisitePhase")
  tasks               DevTask[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  @@unique([projectSlug, code])
  @@index([projectSlug, workstream])
}

model DevDependency {
  phaseId         String   @db.Uuid
  requiresPhaseId String   @db.Uuid
  phase           DevPhase @relation("DependentPhase", fields: [phaseId], references: [id], onDelete: Cascade)
  prerequisite    DevPhase @relation("PrerequisitePhase", fields: [requiresPhaseId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  @@id([phaseId, requiresPhaseId])
  @@index([requiresPhaseId])
}

model DevTask {
  id               String       @id @default(uuid()) @db.Uuid
  phaseId          String       @db.Uuid
  phase            DevPhase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  key              String
  title            String
  description      String       @default("")
  priority         Int          @default(100)
  state            String       @default("planned")
  scopes           Json         @db.JsonB
  coordinationKeys Json         @db.JsonB
  blockers         DevBlocker[]
  agentSessions    DevAgentSession[]
  executions       DevExecution[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  @@unique([phaseId, key])
  @@index([state, priority])
}

model DevBlocker {
  id         String    @id @default(uuid()) @db.Uuid
  taskId     String    @db.Uuid
  task       DevTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind       String
  detail     String
  state      String    @default("open")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  @@index([taskId, state])
}


// D5b durable local agent records. D3 remains the sole owner of MCP auth.
// No model here automatically authorizes execution or represents a verified PR.
model DevAgentSession {
  id           String         @id @default(uuid()) @db.Uuid
  taskId       String         @db.Uuid
  task         DevTask        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  repositoryId String         @db.Uuid
  repository   DevRepository  @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  provider     String         @default("opencode")
  directory    String
  branch       String
  externalId   String?
  state        String         @default("reserved")
  executions   DevExecution[]
  artifacts    DevArtifact[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@unique([provider, externalId])
  @@index([taskId, state])
  @@index([repositoryId, state])
}

model DevExecution {
  id           String          @id @default(uuid()) @db.Uuid
  taskId       String          @db.Uuid
  task         DevTask         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  sessionId    String          @db.Uuid
  session      DevAgentSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  requestKey   String
  action       String
  intent       Json            @db.JsonB
  intentDigest String
  promptSha256 String?
  maxCostCents Int
  state        String          @default("pending")
  fence        Int             @default(0)
  expiresAt    DateTime
  approvedAt   DateTime?
  approvedBy   String?
  claimedAt    DateTime?
  completedAt  DateTime?
  errorCode    String?
  artifacts    DevArtifact[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  @@unique([taskId, requestKey])
  @@index([state, expiresAt])
  @@index([sessionId, state])
}

model DevArtifact {
  id           String          @id @default(uuid()) @db.Uuid
  sessionId    String          @db.Uuid
  session      DevAgentSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  executionId  String          @db.Uuid
  execution    DevExecution    @relation(fields: [executionId], references: [id], onDelete: Restrict)
  source       String
  kind         String
  repository   String
  sha          String?
  reference    String?
  verifiedAt   DateTime?
  observedAt   DateTime        @default(now())
  metadata     Json?           @db.JsonB
  @@index([sessionId, observedAt])
  @@index([repository, sha])
}
