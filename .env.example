# Never store real credentials in Git. Only fake channels in all P0 modes.
RUNTIME_PROFILE=demo
OUTBOUND_ENABLED=false
PORT=4317

# Local SQLite (if using dev:local or dev:api:local)
# SQLITE_PATH=/absolute/path/to/tasks.sqlite

# Development PostgreSQL only (if using dev:postgres)
# DATABASE_URL=postgresql://integron:integron_dev_only@127.0.0.1:5432/integron?schema=public

# P1 owner notifications (PostgreSQL profile only).
# Configure these values in your shell or .env loaded by your process manager.
# Do not commit real tokens/IDs. A Telegram owner must send /start to the bot.
# TELEGRAM_BOT_TOKEN=
# OWNER_TELEGRAM_USER_ID=
# OWNER_TELEGRAM_CHAT_ID=
