# Never store real credentials in Git. Only fake channels in all P0 modes.
RUNTIME_PROFILE=demo
OUTBOUND_ENABLED=false
PORT=4317

# Local SQLite (if using dev:local or dev:api:local)
# SQLITE_PATH=/absolute/path/to/tasks.sqlite

# Development PostgreSQL only (if using dev:postgres)
# DATABASE_URL=postgresql://integron:integron_dev_only@127.0.0.1:5432/integron?schema=public

# P1 owner notifications (PostgreSQL profile only).
# Configure these values in your shell or .env loaded by your process manager.
# Do not commit real tokens/IDs. A Telegram owner must send /start to the bot.
# TELEGRAM_BOT_TOKEN=
# OWNER_TELEGRAM_USER_ID=
# OWNER_TELEGRAM_CHAT_ID=


# P2: explicit private-chat TEST channel, separate from owner Telegram bot.
# NOT a Telegram USER/TDLib account; bots cannot cold-message strangers.
# Start the agent test bot manually from allowlisted contacts before use.
# Enable and set the same allowlist in both API and orchestrator + agent workers.
TEST_TELEGRAM_ENABLED=false
# AGENT_TELEGRAM_BOT_TOKEN=  # different token from TELEGRAM_BOT_TOKEN
# AGENT_TELEGRAM_ALLOWED_CHAT_IDS=  # 1 or 2 private numeric IDs, comma-separated


# P2.2 separate Telegram USER test identity through TDLib. OFF by default.
# Configure in API, orchestrator and USER worker; never commit real values.
TEST_TDLIB_ENABLED=false
# TDLIB_ALLOWED_CHAT_IDS=  # 1-2 consented private user IDs
# TDLIB_API_ID=             # app credentials from https://my.telegram.org
# TDLIB_API_HASH=
# TDLIB_AGENT_USER_ID=      # expected numeric account ID, verified via getMe
# TDJSON_PATH=              # optional explicit absolute path to native libtdjson
# TDLib session defaults to ~/.integron/tdlib-agent (outside Git).


# P2.3 experimental PERSONAL WhatsApp USER via Baileys (disabled by default).
# ONLY 1-2 explicitly consenting test accounts; no bulk or cold outreach.
# No QR is requested unless the separate worker is explicitly started.
TEST_WHATSAPP_USER_ENABLED=false
WHATSAPP_LIVE_CONNECT_ENABLED=false
# WHATSAPP_AGENT_JID=77777777777@s.whatsapp.net  # separate dedicated account
# WHATSAPP_ALLOWED_JIDS=12345678901@s.whatsapp.net  # private 1:1 allowlist
# OWNER_WHATSAPP_JID=                         # optional owner separation check
# Sessions outside repository: ~/.integron/whatsapp-agent/session (private files)
